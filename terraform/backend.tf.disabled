terraform {
  backend "s3" {
    # Bootstrap required: manually create this bucket and DynamoDB table before running `terraform init`
    bucket         = "event-ticketing-tfstate-12345" # Must be globally unique, change if needed
    key            = "terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "terraform-state-lock"
  }
}
