  <diagram id="cost-compare" name="Dev vs Prod Cost Shape">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Cost shape: slim-dev vs hardened-prod (same architecture, different knobs)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Dev column -->
        <mxCell id="dev-col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="dev-h" value="DEV — slim / cost-capped" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dev-budget" value="AWS Budget: $1.00 / month · alert @ 80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dev-items" value="&lt;b&gt;Intentional cost cuts&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Log retention: &lt;b&gt;7 days&lt;/b&gt;&lt;br&gt;• DynamoDB PITR: &lt;b&gt;off&lt;/b&gt;&lt;br&gt;• Detailed alarms (duration / DDB throttle): &lt;b&gt;off&lt;/b&gt;&lt;br&gt;• email_provider: &lt;b&gt;none&lt;/b&gt; (no SMTP traffic)&lt;br&gt;• API throttle: &lt;b&gt;25 rps / burst 50&lt;/b&gt;&lt;br&gt;• S3 force_destroy: &lt;b&gt;true&lt;/b&gt; (easy teardown)&lt;br&gt;• DynamoDB deletion protection: &lt;b&gt;false&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Still present (shared architecture)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• DynamoDB on-demand (PAY_PER_REQUEST)&lt;br&gt;• HTTP API v2 (cheaper than REST)&lt;br&gt;• Lambda 128 MB / 15s, no reserved concurrency&lt;br&gt;• Error-rate + API 5xx alarms&lt;br&gt;• X-Ray Active tracing&lt;br&gt;• CloudFront + private S3 (OAC)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=12;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="460" height="460" as="geometry" />
        </mxCell>
        <mxCell id="dev-why" value="Purpose: verify the full stack end-to-end without burning money while iterating." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=2;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="70" y="655" width="460" height="40" as="geometry" />
        </mxCell>

        <!-- Prod column -->
        <mxCell id="prod-col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="prod-h" value="PROD — hardened / still lean" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="prod-budget" value="AWS Budget: $5.00 / month · alert @ 80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="120" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="prod-items" value="&lt;b&gt;Paid for on purpose (reliability / ops)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Log retention: &lt;b&gt;30 days&lt;/b&gt;&lt;br&gt;• DynamoDB PITR: &lt;b&gt;on&lt;/b&gt;&lt;br&gt;• Detailed alarms (duration / DDB throttle): &lt;b&gt;on&lt;/b&gt;&lt;br&gt;• email_provider: &lt;b&gt;smtp&lt;/b&gt; (real confirmation emails)&lt;br&gt;• API throttle: &lt;b&gt;50 rps / burst 100&lt;/b&gt;&lt;br&gt;• S3 force_destroy: &lt;b&gt;false&lt;/b&gt;&lt;br&gt;• DynamoDB deletion protection: &lt;b&gt;true&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Still avoided (cost discipline)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• No EC2 / ECS / RDS / NAT Gateway&lt;br&gt;• No provisioned DynamoDB capacity&lt;br&gt;• No reserved Lambda concurrency&lt;br&gt;• No custom domain / ACM (default CF cert)&lt;br&gt;• Single-table design → Query, not Scan&lt;br&gt;• Secrets in SSM (no SES production mailbox yet)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#90CAF9;fontSize=12;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="460" height="460" as="geometry" />
        </mxCell>
        <mxCell id="prod-why" value="Purpose: keep the same serverless cost model, pay only for durability and visibility." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=2;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="630" y="655" width="460" height="40" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="See docs/Cost-Analysis.md for the reasoning, rough monthly estimate, and what I would change if traffic grew." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1000" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
